+
+// degradeDisabled 是否整体关闭降级（WB2A_DEGRADE_DISABLE=1/true）。
+// 关闭后撞墙不再有中性提示词抢救，错误原文直接回客户端——排查期的正确形态。
+func degradeDisabled() bool {
+	v := os.Getenv("WB2A_DEGRADE_DISABLE")
+	if v == "" {
+		return false
