+
+	if rec.Code != 400 {
+		t.Fatalf("code=%d want 400 (kill switch must not swap in Degraded)", rec.Code)
+	}
+	if calls != 1 {
+		t.Errorf("upstream calls=%d want 1 (no degraded retry when disabled)", calls)
+	}
+	if h.degrade.Active() {
+		t.Error("degrade must stay inactive when WB2A_DEGRADE_DISABLE=1")
