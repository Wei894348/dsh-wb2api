+	}
+	return def
+}
+
+// AllowProbe 降级期内是否放这一条请求用客户端原文出站（限频）。
+func (g *degradeGate) AllowProbe() bool {
+	iv := probeInterval()
+	if iv == 0 {
+		return false
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if !time.Now().Before(g.until) {
+		return false
+	}
